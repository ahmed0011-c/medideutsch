      "label": "Dialogue",
      "title": "Who does what this morning?",
      "instructions": "Tap the verb endings. They tell you the person.",
      "scene": "7:15 on ward 3B. Anna and Dr. Weber plan the early shift.",
      "sceneTitle": "Dienstbeginn",
      "speakers": {
        "N": {
          "name": "Anna",
          "role": "Pflegekraft",
          "avatar": "🧑‍⚕️"
