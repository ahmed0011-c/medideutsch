      "text": {
        "title": "Auf Station",
        "de": "Ich bin Pflegekraft. Du bist Patient. Herr Yilmaz ist auf Station 3B. Er hat Fieber. Wir haben Visite. Ich habe Durst. Ich möchte Wasser. Die Patientin möchte eine Tablette.",
        "en": "I am a nurse. You are a patient. Mr Yilmaz is on ward 3B. He has a fever. We have a ward round. I am thirsty. I would like water. The patient would like a tablet."
      }
    },
    {
      "id": "dialogue",
      "type": "dialogue",
      "label": "Dialogue",
      "title": "At the nurses' station",
      "instructions": "Listen for bin, hast and möchte.",
      "scene": "Anna brings water. Herr Yilmaz has a fever.",
      "sceneTitle": "Am Stützpunkt",
      "speakers": {
        "N": {
          "name": "Anna",
          "role": "Pflegekraft",
          "avatar": "🧑‍⚕️"
        },
        "P": {
          "name": "Herr Yilmaz",
          "role": "Patient",
          "avatar": "🧑🏽"
        }
      },
      "lines": [
        {
          "who": "N",
          "de": "Guten Tag. Ich bin Anna. Sie sind Herr Yilmaz?",
          "en": "Good day. I am Anna. You are Mr Yilmaz?"
        },
        {
          "who": "P",
          "de": "Ja. Ich habe Fieber und ich habe Durst.",
          "en": "Yes. I have a fever and I am thirsty."
        },
        {
          "who": "N",
          "de": "Möchten Sie Wasser? Wir haben auch Tee.",
          "en": "Would you like water? We also have tea."
        },
        {
          "who": "P",
          "de": "Ich möchte Wasser, bitte.",
          "en": "I would like water, please."
        }
      ]
    },
