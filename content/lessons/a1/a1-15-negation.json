    {
      "id": "overview",
      "type": "overview",
      "label": "Überblick",
      "title": "Lesson intro",
      "minutes": 40,
      "learn": [
        "kein negates a noun that would have ein or no article: keine Schmerzen, kein Fieber.",
        "nicht negates a verb or an adjective: Er isst nicht. Er ist nicht nüchtern.",
        "nie means never. nichts means nothing. niemand means nobody.",
        "nicht mehr means not anymore: Er trinkt nicht mehr."
      ],
