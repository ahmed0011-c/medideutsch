  "title": "Nur mit dir – nie ohne dich",
  "subtitle": "Personal pronouns in the accusative and dative",
  "steps": [
    {
      "id": "overview",
      "type": "overview",
      "label": "Überblick",
      "title": "Lesson intro",
      "minutes": 40,
      "learn": [
        "Accusative: mich, dich, ihn, sie, es, uns, euch, sie, Sie.",
        "Dative: mir, dir, ihm, ihr, ihm, uns, euch, ihnen, Ihnen.",
        "helfen and geben take the dative for the person: Ich helfe Ihnen. Sie gibt ihm die Tablette.",
        "untersuchen and sehen take the accusative: Der Arzt untersucht ihn. Sie sieht mich."
      ],
