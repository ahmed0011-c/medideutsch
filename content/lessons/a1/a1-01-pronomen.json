  "steps": [
    {
      "id": "overview",
      "type": "overview",
      "label": "Überblick",
      "title": "Lesson intro",
      "minutes": 15,
      "learn": [
        "The personal pronouns: ich, du, er, sie, es, wir, ihr, sie and formal <b>Sie</b>.",
        "A thing takes the pronoun of its article: der → er, die → sie, das → es.",
        "With a patient, use <b>Sie</b>. <b>du</b> is for people you know well.",
        "Capital <b>Sie</b> is formal you. Lowercase <b>sie</b> is she or they."
      ],
