  "title": "Wo steht was?",
  "subtitle": "Word order: verb position, time before place",
  "steps": [
    {
      "id": "overview",
      "type": "overview",
      "label": "Überblick",
      "title": "Lesson intro",
      "minutes": 40,
      "learn": [
        "In a statement the verb is in position 2. One idea fills position 1: Heute kommt der Arzt.",
        "In a W-question the verb is also in position 2: Wo liegt der Patient?",
        "In a yes/no question the verb is in position 1: Kommt der Arzt heute?",
        "Neutral order puts time before place: Am Morgen liegt der Patient im Zimmer."
      ],
      "vocab": [
