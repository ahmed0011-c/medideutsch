  "subtitle": "Noun plurals",
  "steps": [
    {
      "id": "overview",
      "type": "overview",
      "label": "Überblick",
      "title": "Lesson intro",
      "minutes": 40,
      "learn": [
        "Most feminine nouns and nouns in -e, -ung, -heit, -ion take -(e)n: die Spritze → die Spritzen.",
        "Many masculine nouns take -e, often with an umlaut: der Arzt → die Ärzte.",
        "Nouns in -er, -el, -en and diminutives in -chen often take no ending: das Zimmer → die Zimmer.",
        "Loanwords, abbreviations and nouns in -a, -i, -o, -y often take -s: das Baby → die Babys, das EKG → die EKGs."
      ],
      "vocab": [
