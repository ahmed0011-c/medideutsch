          ]
        },
        {
          "title": "Bleibt zusammen",
          "caption": "be-, er-, ver- and untersuchen. The participle has no ge-.",
          "columns": ["Präsens", "Perfekt"],
          "rows": [
            { "label": "untersuchen", "cells": ["untersucht", "hat untersucht"], "highlight": true },
            { "label": "bestellen", "cells": ["bestellt", "hat bestellt"], "highlight": true },
            { "label": "erklären", "cells": ["erklärt", "hat erklärt"] },
            { "label": "verstehen", "cells": ["versteht", "hat verstanden"] },
            { "label": "bekommen", "cells": ["bekommt", "hat bekommen"] }
          ]
        },
        {
          "title": "Nicht diese Form",
          "caption": "The finite prefix does not stay stuck, and be- is not a separable prefix.",
          "columns": ["Falsch", "Richtig"],
          "rows": [
            { "label": "aufstehen", "cells": ["aufsteht", "steht … auf"] },
            { "label": "untersuchen", "cells": ["sucht … unter", "untersucht"] },
            { "label": "bestellen", "cells": ["stellt … be", "bestellt"] },
            { "label": "muss", "cells": ["muss stehen auf", "muss aufstehen"] },
            { "label": "Perfekt", "cells": ["hat aufgestanden", "ist aufgestanden"] }
          ]
        }
      ],
