  "title": "War, hätte, würde …",
  "subtitle": "Konjunktiv II forms",
  "glossary": {
    "war": {
      "de": "sein → er war",
      "pos": "form",
      "en": "was",
      "emoji": "🟦",
      "note": "Präteritum, chapter 23. The Konjunktiv II is wäre. du warst, the Konjunktiv du is wärst. ihr wart, the Konjunktiv ihr is wärt."
    },
    "hätte": {
      "de": "haben → ich hätte",
      "pos": "form",
      "en": "would have",
      "emoji": "🕐",
      "note": "Konjunktiv II. Umlaut on hatte. Ich hätte Zeit. hatte is the past state. Not hättete."
    },
    "würde": {
      "de": "werden → ich würde",
      "pos": "form",
      "en": "would",
      "emoji": "🙏",
      "note": "Konjunktiv II. Umlaut on wurde. würde plus a bare infinitive: würde warten. No zu. wurde is the past. du würdest keeps the e."
    },
    "ich": { "de": "ich", "pos": "pronoun", "en": "I", "emoji": "🙋" },
    "zeit": {
      "de": "Zeit",
      "pos": "noun",
      "en": "time",
      "emoji": "🕐",
      "article": "die",
      "plural": "die Zeiten",
      "note": "No article in the polite line: Ich hätte Zeit. Hätten Sie Zeit?"
    },
    "könnten": {
      "de": "können → Sie könnten",
      "pos": "form",
      "en": "could (formal you or they)",
      "emoji": "🤝",
      "note": "Formal Sie and wir. She könnte. konnte is the night-report past from chapter 27."
    },
    "sie": {
      "de": "sie",
      "pos": "pronoun",
      "en": "she; they; formal you",
      "emoji": "👩",
      "note": "She könnte, sie wäre. Formal you: Könnten Sie, Würden Sie, Hätten Sie. They könnten."
    },
    "mir": {
      "de": "mir",
      "pos": "pronoun",
      "en": "me (dative)",
      "emoji": "🤝",
      "note": "helfen takes the person in the dative, chapter 22. Könnten Sie mir helfen? Not mich."
    },
    "helfen": {
      "de": "helfen → Sie helfen",
      "pos": "form",
      "en": "help",
      "emoji": "🤝",
      "note": "Infinitive at the end. The person is mir: Könnten Sie mir helfen?"
    },
    "würden": {
      "de": "werden → Sie würden",
      "pos": "form",
      "en": "would (formal you or they)",
      "emoji": "🙏",
      "note": "Formal Sie and wir. She würde. Würden Sie bitte warten? The infinitive has no zu."
    },
    "bitte": {
      "de": "bitte",
      "pos": "particle",
      "en": "please",
      "emoji": "🙏",
      "note": "Softens the request. Würden Sie bitte warten? Not the verb bitten."
    },
    "warten": {
      "de": "warten → Sie warten",
      "pos": "form",
      "en": "wait",
      "emoji": "⏳",
      "note": "Bare infinitive after würde: Würden Sie bitte warten? Not zu warten."
    },
    "wäre": {
      "de": "sein → sie wäre",
      "pos": "form",
      "en": "would be",
      "emoji": "😴",
      "note": "Konjunktiv II. Umlaut on war. Sie wäre müde. du wärst. ihr wärt. war is the past state."
