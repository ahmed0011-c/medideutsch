      "note": "Konjunktiv II. Umlaut on musste. Er müsste den Arzt rufen. musste is the night-report past. No zu."
    },
    "den": {
      "de": "den",
      "pos": "article",
      "en": "the (masculine accusative)",
      "emoji": "🔵",
