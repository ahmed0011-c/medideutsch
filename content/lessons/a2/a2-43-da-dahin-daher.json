      ],
      "text": {
        "title": "Ich bin da",
        "de": "Ich bin da. Der Patient ist da. Wir gehen dahin. Er kommt daher. Kommst du auch dahin?",
        "en": "I am there. The patient is there. We go there. He comes from there. Are you coming there too?"
      }
