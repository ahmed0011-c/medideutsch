  "steps": [
    {
      "id": "overview",
      "type": "overview",
      "label": "Überblick",
      "title": "Lesson intro",
      "minutes": 20,
      "learn": [
        "<b>und, aber, oder, denn, sondern</b> stand in position 0. They do not count as a sentence position.",
        "The verb in the next main clause stays in <b>position 2</b>.",
        "<b>denn</b> means because, and the verb stays in position 2. <b>weil</b> sends the verb to the end.",
        "After a negative, a correction uses <b>sondern</b>, not aber: nicht A, sondern B."
      ],
      "vocab": [
