  "id": "a2-36-adjektive",
  "level": "A2",
  "unit": "Kapitel 36",
  "chapter": 36,
  "chapters": [
    36
  ],
  "title": "Ein netter Mann! Ich liebe den netten Mann",
  "subtitle": "Adjective endings in the nominative and accusative",
  "steps": [
    {
      "id": "overview",
      "type": "overview",
      "label": "Überblick",
      "title": "Lesson intro",
      "minutes": 40,
      "learn": [
        "An attributive adjective takes an ending. The gender signal sits on the article or on the adjective.",
        "der starke Schmerz: the article shows -r, so the adjective is -e. ein starker Schmerz: ein shows nothing, so the adjective takes -r.",
        "Accusative masculine is always -en: den starken Schmerz, einen starken Schmerz.",
        "After sein there is no ending: Der Schmerz ist stark."
      ],
      "vocab": [
        {
          "de": "Schmerz",
          "article": "der",
          "plural": "die Schmerzen",
          "en": "pain",
          "emoji": "⚡",
          "glossaryKey": "schmerz"
        },
        {
          "de": "Übelkeit",
          "article": "die",
          "plural": "Übelkeit",
          "en": "nausea",
          "emoji": "🤢",
          "glossaryKey": "übelkeit"
        },
        {
          "de": "Pflaster",
          "article": "das",
          "plural": "die Pflaster",
          "en": "plaster",
          "emoji": "🩹",
          "glossaryKey": "pflaster"
        },
        {
          "de": "Verband",
          "article": "der",
          "plural": "die Verbände",
          "en": "dressing",
          "emoji": "🩹",
          "glossaryKey": "verband"
        },
        {
          "de": "Befund",
          "article": "der",
          "plural": "die Befunde",
          "en": "finding",
          "emoji": "📄",
          "glossaryKey": "befund"
        },
        {
          "de": "Arm",
          "article": "der",
          "plural": "die Arme",
          "en": "arm",
          "emoji": "💪",
          "glossaryKey": "arm"
        }
      ],
      "text": {
        "title": "Der starke Schmerz",
        "de": "Der Patient hat einen starken Schmerz im Arm. Die Übelkeit ist leicht. Die Pflegekraft gibt ein kleines Pflaster auf den Arm. Der Befund ist neu. Der Verband ist gut.",
        "en": "The patient has a severe pain in the arm. The nausea is mild. The nurse gives a small plaster onto the arm. The finding is new. The dressing is good."
      }
    },
    {
      "id": "grammar",
      "type": "grammar",
      "label": "Grammar",
      "title": "The signal on the article or the adjective",
      "practice": "choose",
      "heroTitle": "Nominative and accusative",
      "heroImage": "plaster",
      "story": [
        "<b>Der starke Schmerz</b> and <b>ein starker Schmerz</b> are both nominative. The -r sits in a different place.",
        "<b>Den starken Schmerz</b> is accusative. After ist the adjective is bare: <b>Der Schmerz ist stark</b>."
      ],
      "questionRule": "Use <b>Schmerz, Verband, Arm, Befund</b> to see the ending. Patient is an n-noun: den neuen Patienten has -en twice, so the adjective ending is hidden.",
      "tables": [
        {
          "title": "Nominativ und Akkusativ",
          "caption": "The highlighted row is the one that always changes: accusative masculine.",
          "columns": [
            "Maskulin",
            "Neutrum",
            "Feminin",
            "Plural"
          ],
          "rows": [
            {
              "label": "Nom der",
              "cells": [
                "der starke Schmerz",
                "das kleine Pflaster",
                "die leichte Übelkeit",
                "die neuen Verbände"
              ]
            },
            {
              "label": "Nom ein",
              "cells": [
                "ein starker Schmerz",
                "ein kleines Pflaster",
                "eine leichte Übelkeit",
                "keine neuen Verbände"
              ]
            },
            {
              "label": "Akk der",
              "cells": [
                "den starken Schmerz",
                "das kleine Pflaster",
                "die leichte Übelkeit",
                "die neuen Verbände"
              ],
              "highlight": true
            },
            {
              "label": "Akk ein",
              "cells": [
                "einen starken Schmerz",
                "ein kleines Pflaster",
                "eine leichte Übelkeit",
                "keine neuen Verbände"
              ],
              "highlight": true
            }
          ]
        }
      ],
      "warning": {
        "title": "Keine Endung nach sein",
        "items": [
          {
            "de": "Der Schmerz ist stark.",
            "en": "After sein the adjective is predicative and has no ending.",
            "tone": "ok"
          },
          {
            "de": "Der Schmerz ist starker.",
            "en": "starker is an attributive ending. It does not follow sein.",
            "tone": "stop"
          },
          {
            "de": "ein starker Schmerz",
            "en": "Nominative masculine: the signal -r is on the adjective.",
            "tone": "ok"
          },
          {
            "de": "ein starken Schmerz",
            "en": "Nominative does not take -en.",
            "tone": "stop"
          },
          {
            "de": "den neuen Patienten",
            "en": "Patient also adds -en. Prefer der Schmerz when you are learning the adjective.",
            "tone": "stop"
          }
        ],
        "tip": "Accusative masculine is the row to memorise: den starken, einen starken. Feminine and neuter look the same in the nominative and the accusative."
      },
      "tips": [
        {
          "title": "Where is the signal?",
          "body": "der, die and das already show r, e or s, so the adjective only takes -e. ein shows nothing, so the adjective takes -er, -e or -es. Accusative masculine ignores that and takes -en.",
